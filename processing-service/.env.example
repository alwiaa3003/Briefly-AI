# ---------------------------------------------------------------
# Briefly AI — processing service (FastAPI)
# Copy to processing-service/.env and fill in the values.
# ---------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# Bind to localhost only: this service must not be publicly reachable.
# Only the Express API and the BullMQ worker call it.
HOST=127.0.0.1
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Shared secret required in the X-Internal-Token header of every /internal/*
# request. Must match INTERNAL_SERVICE_SECRET in backend/.env.
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_SECRET=change-me-generate-a-long-random-string

# Interactive API docs (/docs). Disabled automatically in production.
DOCS_ENABLED=true

# ---- Google Gemini ----------------------------------------------
# API key from https://aistudio.google.com/apikey. Server-side only: it is
# never sent to the browser or logged. Never commit a real key.
# Without it, article jobs fail with AI_NOT_CONFIGURED.
GEMINI_API_KEY=
# Generation model (summaries, Ask AI, study tools). Change it here, not in code.
# Use a model the pricing page lists as "Free of charge" on the Free tier, and
# check its quota in Google AI Studio. Briefly never switches models on its own;
# an unavailable model fails with AI_MODEL_UNAVAILABLE.
# Default: gemini-3.5-flash-lite (stable, listed as free; verified with
# structured output). gemini-2.5-flash is deprecated by Google.
# See README "Free-tier operation".
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request timeout (seconds)
GEMINI_TIMEOUT_SECONDS=90
# Lower values keep summaries closer to the source text
GEMINI_TEMPERATURE=0.2
# Upper bound on generated tokens (includes model "thinking" on some models)
GEMINI_MAX_OUTPUT_TOKENS=16384

# ---- Article fetching & extraction ------------------------------
# Timeout for each request to the article's website (seconds)
ARTICLE_FETCH_TIMEOUT_SECONDS=15
# Maximum page size downloaded (bytes, default 5 MB)
ARTICLE_MAX_BYTES=5242880
# Maximum redirects followed (each hop is re-validated against SSRF rules)
ARTICLE_MAX_REDIRECTS=5
# Pages with fewer extracted words are rejected (paywalls, JS-only pages)
ARTICLE_MIN_WORDS=120
# Characters of article text sent to Gemini; longer articles are truncated
ARTICLE_MAX_SUMMARY_CHARS=60000
# Characters of article text returned for storage in MongoDB
ARTICLE_MAX_STORED_CHARS=300000
# User-Agent sent when fetching articles
ARTICLE_USER_AGENT=BrieflyAI/0.2 (+article summarizer)

# ---- YouTube ------------------------------------------------------
# Optional YouTube Data API v3 key (Google Cloud console, "YouTube Data API v3").
# With it: duration, publish date, caption-track kinds, privacy/age/live checks
# and chunked transcription of long videos. Without it, only title/channel/
# thumbnail come from YouTube's public oEmbed endpoint.
YOUTUBE_API_KEY=

# ---- Transcription ------------------------------------------------
# Provider registry key; "gemini" is the only provider implemented.
TRANSCRIPTION_PROVIDER=gemini
# Model for transcription; empty = GEMINI_MODEL
TRANSCRIPTION_MODEL=
TRANSCRIPTION_MAX_OUTPUT_TOKENS=32768
# Transcript characters sent to the video summarizer
VIDEO_MAX_SUMMARY_CHARS=250000

# ---- Uploaded video processing ------------------------------------
# Optional path to ffmpeg; empty = binary bundled with imageio-ffmpeg
FFMPEG_PATH=
FFMPEG_TIMEOUT_SECONDS=300
# Comma-separated hosts that signed storage URLs may use,
# e.g. <account-id>.r2.cloudflarestorage.com. Required when
# ENVIRONMENT=production (downloads are refused otherwise).
STORAGE_DOWNLOAD_HOSTS=

# ---- Documents (PDF / DOCX / TXT) ------------------------------------
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=1000
# Extracted characters kept per document; the rest is reported as truncated
DOCUMENT_MAX_CHARS=2000000
# DOCX/TXT have no fixed pages: text is grouped into parts of about this size
DOCUMENT_PART_CHARS=4000
# Longer paragraphs are split at sentence boundaries
DOCUMENT_MAX_BLOCK_CHARS=4000
# Zip-bomb guard for DOCX (total uncompressed bytes)
DOCX_MAX_UNCOMPRESSED_BYTES=209715200
# Chunk notes larger than this are merged hierarchically before the final summary
DOCUMENT_COMBINE_MAX_CHARS=150000

# ---- OCR (scanned PDF pages) ----------------------------------------
# Provider registry key; "gemini" is the only provider implemented
OCR_PROVIDER=gemini
# Model for OCR; empty = GEMINI_MODEL
OCR_MODEL=
OCR_DPI=150
OCR_MAX_PAGES_PER_REQUEST=5

# ---- Embeddings, Ask AI and study tools (Milestone 5) -----------------
# Uses GEMINI_API_KEY. Changing the model or dimensions requires
# re-indexing (vectors from different models are not comparable) and
# EMBEDDING_DIMENSIONS must match the backend and the Atlas vector index.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
# Max characters of retrieved context sent with one question
RAG_MAX_CONTEXT_CHARS=16000
# Max characters of source content sent to study-tool generation
STUDY_MAX_INPUT_CHARS=80000
