# ---------------------------------------------------------------
# Briefly AI — frontend (Vite)
# Copy to frontend/.env.local to override.
#
# IMPORTANT: every VITE_* variable is embedded in the public JavaScript
# bundle. Never put secrets or API keys here.
# ---------------------------------------------------------------

# Base URL the browser uses for API calls. The default "/api" goes through the
# Vite dev-server proxy (below), so the app and API share one origin in
# development and the refresh-token cookie stays first-party.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (the Express backend).
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
