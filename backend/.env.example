# ---------------------------------------------------------------
# Briefly AI — Express API and BullMQ worker
# Copy to backend/.env and fill in the values.
# Values starting with "change-me" are rejected at startup.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# Comma-separated list of browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 when running behind a single reverse proxy (e.g. in production)
TRUST_PROXY=0

# Log level: error | warn | info | debug | silent
LOG_LEVEL=info

# ---- MongoDB --------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/briefly_ai

# ---- Redis / BullMQ -------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Prefix for all BullMQ keys in Redis
QUEUE_PREFIX=briefly
# Number of jobs a single worker process handles concurrently
WORKER_CONCURRENCY=2
# Bounded retries for background jobs
JOB_MAX_ATTEMPTS=3
# Initial exponential backoff delay between retries (milliseconds)
JOB_BACKOFF_MS=2000

# ---- Authentication -------------------------------------------
# Secret for signing short-lived access tokens (JWT, HS256).
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
# Access token lifetime (vercel/ms format, e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days (opaque token stored hashed in MongoDB,
# delivered in an httpOnly cookie)
REFRESH_TOKEN_TTL_DAYS=7
# Send the refresh cookie only over HTTPS. Defaults to true in production.
COOKIE_SECURE=false
# bcrypt cost factor (10-14 is reasonable)
BCRYPT_SALT_ROUNDS=12
# Max auth requests per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# ---- Processing service (FastAPI) -----------------------------
PROCESSING_SERVICE_URL=http://127.0.0.1:8000
# Shared secret for internal service-to-service calls.
# Must match INTERNAL_SERVICE_SECRET in processing-service/.env.
INTERNAL_SERVICE_SECRET=change-me-generate-a-long-random-string
# Timeout for calls to the processing service (milliseconds)
PROCESSING_SERVICE_TIMEOUT_MS=10000
# Timeout for article fetch + extraction calls (milliseconds)
PROCESSING_EXTRACT_TIMEOUT_MS=45000
# Timeout for Gemini summarization calls (milliseconds)
PROCESSING_SUMMARIZE_TIMEOUT_MS=200000

# ---- Article summarization -------------------------------------
# New article summaries (and retries) allowed per user per hour
ARTICLE_RATE_LIMIT_MAX=20

# ---- Google Gemini --------------------------------------------
# The Gemini API key belongs to the processing service
# (processing-service/.env), not to this API. It is never sent to the browser.

# ---- Video summarization ---------------------------------------
# Long recordings are transcribed in windows of this many seconds
TRANSCRIPTION_CHUNK_SECONDS=600
# Longest YouTube video accepted (minutes; enforced when the duration is known)
YOUTUBE_MAX_DURATION_MINUTES=180
# Timeouts for video calls to the processing service (milliseconds)
PROCESSING_VIDEO_PREPARE_TIMEOUT_MS=120000
PROCESSING_TRANSCRIBE_TIMEOUT_MS=420000

# ---- Video uploads: S3-compatible object storage ----------------
# Uploads are DISABLED until all four required values are set.
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com,
# region "auto", and an R2 API token with Object Read & Write on the bucket.
# Keep the bucket private (no public access); Briefly only uses signed URLs.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Signed URLs use https://<endpoint-host>/<bucket>/... when true, or
# https://<bucket>.<endpoint-host>/... when false. The host must match the
# processing service's STORAGE_DOWNLOAD_HOSTS. Use true for Backblaze B2
# (STORAGE_DOWNLOAD_HOSTS=s3.<region>.backblazeb2.com) and MinIO.
STORAGE_FORCE_PATH_STYLE=false
# Lifetime of signed download/playback URLs (seconds)
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Upload limits
UPLOAD_MAX_BYTES=524288000
VIDEO_MAX_DURATION_MINUTES=180
# Uploaded files are deleted after N days (transcripts and summaries remain)
UPLOAD_RETENTION_DAYS=7
# Files of uploads that failed permanently are deleted after N hours
UPLOAD_FAILED_RETENTION_HOURS=24
# Video uploads per user per hour
UPLOAD_RATE_LIMIT_MAX=10

# ---- Documents (PDF / DOCX / TXT) --------------------------------
# Uses the same object storage as video uploads (STORAGE_* above).
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=1000
# Original files are deleted after N days; extracted text and summaries remain
DOCUMENT_RETENTION_DAYS=30
# Documents up to this many extracted characters are summarized in one request
DOCUMENT_SINGLE_PASS_CHARS=150000
# Longer documents are split into chunks of about this size (map-reduce)
DOCUMENT_CHUNK_CHARS=60000
# Cost control: at most this many scanned pages are read with OCR
DOCUMENT_MAX_OCR_PAGES=50
DOCUMENT_OCR_BATCH_PAGES=5
# Timeouts for document calls to the processing service (milliseconds)
PROCESSING_DOCUMENT_EXTRACT_TIMEOUT_MS=600000
PROCESSING_OCR_TIMEOUT_MS=420000
PROCESSING_DOCUMENT_SUMMARIZE_TIMEOUT_MS=900000

# ---- Ask AI, smart search and study tools (Milestone 5) ------------
# Embeddings and answers are produced by the processing service with
# GEMINI_API_KEY (no extra credentials). Vectors are stored in MongoDB.
#
# Vector store: atlas = MongoDB Atlas Vector Search (run
# `npm run rag:create-index` once); exact = in-process cosine search
# (local MongoDB / tests); auto = atlas when the index is queryable.
VECTOR_STORE=auto
VECTOR_INDEX_NAME=content_chunks_vector
# Must match EMBEDDING_DIMENSIONS of the processing service and the
# Atlas index. Changing it requires `npm run rag:create-index` and
# `npm run rag:backfill -- --all`.
EMBEDDING_DIMENSIONS=768
# Index every source automatically when its summary completes
RAG_AUTO_INDEX=true
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
RAG_MAX_CHUNKS_PER_SOURCE=3000
RAG_EMBED_BATCH_SIZE=64
# Chunks retrieved per question / candidates considered by Atlas
RAG_TOP_K=8
RAG_NUM_CANDIDATES=150
# Max chunks scanned by the exact store
RAG_EXACT_SCAN_LIMIT=20000
# Previous messages sent with a question, and max question length
CHAT_HISTORY_MESSAGES=8
CHAT_MAX_MESSAGE_CHARS=2000
# Characters of source content sampled for one study-tool generation
STUDY_INPUT_CHARS=60000
# Per-user hourly limits
CHAT_RATE_LIMIT_MAX=60
STUDY_RATE_LIMIT_MAX=30
SEARCH_RATE_LIMIT_MAX=120
# Timeouts for AI calls to the processing service (milliseconds)
PROCESSING_EMBED_TIMEOUT_MS=60000
PROCESSING_ANSWER_TIMEOUT_MS=90000
PROCESSING_STUDY_TIMEOUT_MS=300000

# ---- Free-tier AI usage controls (Briefly's own limits) -------------
# These protect a free Gemini project. They are NOT Google's quotas:
# Google sets those per project, may change them at any time, and shows
# them only in Google AI Studio (https://aistudio.google.com/rate-limit).
# The defaults stay below the 20 generation requests/day observed for
# gemini-2.5-flash on a free project. Raise them only after checking
# your own quotas in AI Studio.
#
# Daily budgets reset at midnight in this time zone (Google resets its
# daily quotas at midnight Pacific).
AI_BUDGET_TIMEZONE=America/Los_Angeles
# Gemini generation requests per day, whole app and per feature group
AI_APP_DAILY_GENERATION_LIMIT=15
AI_APP_DAILY_SUMMARY_LIMIT=10
AI_APP_DAILY_CHAT_LIMIT=8
AI_APP_DAILY_STUDY_LIMIT=6
# Generation requests per user per day
AI_USER_DAILY_GENERATION_LIMIT=10
# Embedding requests per day (one request embeds a batch of chunks)
AI_APP_DAILY_EMBEDDING_LIMIT=500
AI_USER_DAILY_EMBEDDING_LIMIT=200
# Requests per minute Briefly allows itself, and parallel calls
AI_GENERATION_RPM=4
AI_EMBEDDING_RPM=30
AI_MAX_CONCURRENT_GENERATIONS=2
AI_MAX_CONCURRENT_EMBEDDINGS=2
# Used only when Gemini does not say how long to wait (seconds)
AI_RATE_LIMIT_FALLBACK_SECONDS=60
AI_QUOTA_FALLBACK_SECONDS=3600
# Jobs waiting for quota are delayed (no worker is occupied) at most this
# many times / this long, then fail with a clear message (retry later).
AI_MAX_DEFERRALS=30
AI_MAX_DEFER_HOURS=48
AI_MAX_DELAY_SECONDS=21600
# First retry delay for transient AI errors (overloaded model, timeout)
AI_TRANSIENT_RETRY_SECONDS=20
# auto = Redis (shared by API and workers) when connected; memory = per process
AI_GATE_STORE=auto
# Smart search: minimum semantic relevance (0..1, Atlas vectorSearchScore
# scale). 0.80 was calibrated with gemini-embedding-001 (see README).
RAG_SEARCH_MIN_SCORE=0.8
# Ask AI retrieval threshold (0 = off)
RAG_CHAT_MIN_SCORE=0
