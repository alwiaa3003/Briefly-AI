# ---------------------------------------------------------------
# Briefly AI — root environment (used by docker-compose.yml only)
#
# Copy to `.env` in the repository root if you want to change the
# host ports that Docker Compose publishes. Each application has its
# own .env.example:
#   frontend/.env.example
#   backend/.env.example
#   processing-service/.env.example
# ---------------------------------------------------------------

# Host port for MongoDB (published on 127.0.0.1 only)
MONGO_PORT=27017

# Host port for Redis (published on 127.0.0.1 only)
REDIS_PORT=6379
